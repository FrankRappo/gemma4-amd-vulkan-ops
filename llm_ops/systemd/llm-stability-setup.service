[Unit]
Description=LLM 2.5G link and GPU runtime stability settings
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/llm-stability-setup.sh
ExecStart=/usr/local/sbin/llm-amd-compute-profile.sh enable
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
