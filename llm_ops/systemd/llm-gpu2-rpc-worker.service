[Unit]
Description=Gemma 4 llama.cpp b10012 RPC worker on srv2 GPU
After=network-online.target llm-stability-setup.service
Wants=network-online.target
Conflicts=llm-gpu2-local-server.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/llm-gpu2-rpc-worker
ExecStart=/opt/llm-rpc/run-gemma4-rpc-b10012.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGINT
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
