+    std::vector<uint8_t> original(total_size);
+    for (int64_t e = 0; e < n_experts; e++) {
+        const size_t eo = e * expert_size;
+        for (int64_t row = 0; row < n_rows; row++) {
+            for (int64_t kb = 0; kb < blocks_per_row; kb++) {
