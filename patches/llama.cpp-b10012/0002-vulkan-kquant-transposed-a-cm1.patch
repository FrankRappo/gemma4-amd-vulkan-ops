+                       transposed.data() + eo + (kb * n_rows + row) * block_size,
+                       block_size);
+            }
+        }
+    }
+
+    ggml_vk_buffer_write(buf, buf_off, original.data(), total_size);
+    buf_ctx->transposed_a_tensors.erase(tensor);
+}
