@@ -369,7 +369,23 @@ FLOAT_TYPE mmvq_dot_product(const uint ib_a, const uint iqs) {
     int32_t q_sum = 0;

     const i32vec4 qs_a = repack4(ib_a, iqs * 4);
+
+#if defined(DATA_A_Q4_K)
+    // Adjacent lanes process the two 16-value halves of the same Q4_K/Q8_1
+    // block and therefore need identical dm/scale values. Load them in the
+    // even lane and broadcast to its partner while preserving the original
+    // lane mapping, dot-product sequence and subgroup reduction order.
+    vec2 dm_scale = vec2(0.0f);
+    if ((gl_SubgroupInvocationID & 1u) == 0u) {
+        dm_scale = get_dm_scale(ib_a, iqs * 4);
+    }
+    const vec2 peer_dm_scale = subgroupShuffleXor(dm_scale, 1u);
+    if ((gl_SubgroupInvocationID & 1u) != 0u) {
+        dm_scale = peer_dm_scale;
+    }
+#else
     const vec2 dm_scale = get_dm_scale(ib_a, iqs * 4);
+#endif

     q_sum += dotPacked4x8EXT(qs_a.x, cache_b_qs[0]);
     q_sum += dotPacked4x8EXT(qs_a.y, cache_b_qs[1]);
